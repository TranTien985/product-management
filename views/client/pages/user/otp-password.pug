extends ../../layouts/auth.pug
include ../../mixins/show-alert.pug

block main 
  +alert-error(5000)

  .container.my-5 
    .row.justify-content-center 
      .col-md-8.col-lg-6.col-xl-5
        .card.shadow-lg.border-0.rounded-lg.mt-5
          .card-body
            h3.text-center.font-weight-light.my-4 Xác thực OTP
            
            form(
              action=`/user/password/otp`
              method="POST"
            )
              div(class="form-group")
                label(class="small mb-1" for="email") Email nhận mã
                input(
                  type="text"
                  class="form-control py-4 bg-light"
                  id="email"
                  name="email"
                  value=email
                  readonly
                )
            
              div(class="form-group")
                label(class="small mb-1" for="otp") Mã OTP
                input(
                  type="text"
                  class="form-control py-4 text-center font-weight-bold"
                  id="otp"
                  name="otp"
                  placeholder="------"
                  maxlength="8"
                  style="letter-spacing: 5px; font-size: 1.2rem;"
                  required
                  autofocus
                )
                
                //- [QUAN TRỌNG] Input ẩn chứa thời gian hết hạn từ Database
                input(type="hidden" id="data-expire-at" value=expireAt)

                div.d-flex.justify-content-between.align-items-center.mt-2
                  //- Hiển thị thời gian
                  small.text-muted
                    | Thời gian còn lại: 
                    span#otp-countdown(style="font-weight: bold; color: #d9534f;") --:--

                  //- Nút gửi lại mã (Ban đầu ẩn link đi)
                  a#btn-resend.small.text-muted(
                    href="/user/password/forgot" 
                    style="pointer-events: none; cursor: default; text-decoration: none; opacity: 0.6;"
                  ) Gửi lại mã

              div(class="form-group mt-4 mb-0")
                button(
                  type="submit"
                  class="btn btn-primary btn-block py-2"
                  id="btn-confirm"
                ) Xác nhận

            .text-center.py-3
              div.small
                a(href="/user/login") Quay lại đăng nhập
  
  script(src="/js/forgot-password.js") 